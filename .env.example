# =============================================================================
# CyberLearn — Jeu Intelligent
# Variables d'environnement — COPIER CE FICHIER EN .env ET REMPLIR LES VALEURS
# Ne jamais committer le fichier .env dans git
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# APP_ENV=production

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=cyberlearn
POSTGRES_USER=cyberlearn_user
POSTGRES_PASSWORD=changeme_strong_password_here

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password_here

# ─── JWT — Générer avec : openssl rand -hex 32 ────────────────────────────────
JWT_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# ─── Ports (développement) ────────────────────────────────────────────────────
API_PORT=8000
AI_PORT=8001
FRONTEND_PORT=3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
